# LAB-HEX only. Additive, idempotent expiry controls. See docs/PPPOE-EXPIRY-LAB.md.
:if ([/system identity get name] != "LAB-HEX") do={ :error "STOPPED: LAB-HEX only" }
:if (([/ip proxy get enabled]=true) && ([:len [/ip proxy access find where comment="netops-expiry: redirect only"]]=0)) do={ :error "STOPPED: unrelated proxy enabled" }
:if ([:len [/ip firewall address-list find where comment="netops-expiry: portal"]]=0) do={ /ip firewall address-list add list=netops-expired-portal address=netops.kadenetworks.com comment="netops-expiry: portal" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: allow portal"]]=0) do={ /ip firewall filter add chain=netops-expired-fwd protocol=tcp dst-address-list=netops-expired-portal dst-port=80,443 action=accept comment="netops-expiry: allow portal" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: block internet"]]=0) do={ /ip firewall filter add chain=netops-expired-fwd action=drop comment="netops-expiry: block internet" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: router DNS UDP"]]=0) do={ /ip firewall filter add chain=netops-expired-in protocol=udp dst-port=53 action=accept comment="netops-expiry: router DNS UDP" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: router DNS TCP"]]=0) do={ /ip firewall filter add chain=netops-expired-in protocol=tcp dst-port=53 action=accept comment="netops-expiry: router DNS TCP" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: HTTP redirect listener"]]=0) do={ /ip firewall filter add chain=netops-expired-in protocol=tcp dst-port=8099 action=accept comment="netops-expiry: HTTP redirect listener" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: block router services"]]=0) do={ /ip firewall filter add chain=netops-expired-in action=drop comment="netops-expiry: block router services" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: restricted input"]]=0) do={ /ip firewall filter add chain=input src-address=10.20.0.0/22 src-address-list=no-internet action=jump jump-target=netops-expired-in place-before=[find where comment="defconf: accept established,related,untracked"] comment="netops-expiry: restricted input" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: deny other proxy clients"]]=0) do={ /ip firewall filter add chain=input protocol=tcp dst-port=8099 action=drop place-before=[find where comment="defconf: accept established,related,untracked"] comment="netops-expiry: deny other proxy clients" }
:if ([:len [/ip firewall filter find where comment="netops-expiry: restricted forwarding"]]=0) do={ /ip firewall filter add chain=forward src-address=10.20.0.0/22 src-address-list=no-internet action=jump jump-target=netops-expired-fwd place-before=[find where comment="defconf: accept in ipsec policy"] comment="netops-expiry: restricted forwarding" }
:if ([:len [/ip proxy access find where comment="netops-expiry: redirect only"]]=0) do={ /ip proxy access add src-address=10.20.0.0/22 action=redirect action-data="https://netops.kadenetworks.com/portal/?expired=1" comment="netops-expiry: redirect only" }
:if ([:len [/ip proxy access find where comment="netops-expiry: deny proxy forwarding"]]=0) do={ /ip proxy access add action=deny comment="netops-expiry: deny proxy forwarding" }
/ip proxy set port=8099 cache-on-disk=no max-cache-size=0 max-client-connections=64 max-server-connections=16 enabled=yes
:if ([:len [/ip firewall nat find where comment="netops-expiry: DNS UDP"]]=0) do={ /ip firewall nat add chain=dstnat src-address=10.20.0.0/22 src-address-list=no-internet protocol=udp dst-port=53 action=redirect to-ports=53 comment="netops-expiry: DNS UDP" }
:if ([:len [/ip firewall nat find where comment="netops-expiry: DNS TCP"]]=0) do={ /ip firewall nat add chain=dstnat src-address=10.20.0.0/22 src-address-list=no-internet protocol=tcp dst-port=53 action=redirect to-ports=53 comment="netops-expiry: DNS TCP" }
:if ([:len [/ip firewall nat find where comment="netops-expiry: HTTP to renewal"]]=0) do={ /ip firewall nat add chain=dstnat src-address=10.20.0.0/22 src-address-list=no-internet protocol=tcp dst-port=80 dst-address-list=!netops-expired-portal action=redirect to-ports=8099 comment="netops-expiry: HTTP to renewal" }
