[Unit]
Description=Network Hub CWMP connection isolation
After=network.target network-hub-acs-cwmp.service
[Service]
Type=simple
User=genieacs
Group=genieacs
ExecStart=/opt/network-hub-acs/node/bin/node /opt/network-hub-acs/cwmp-proxy.cjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
[Install]
WantedBy=multi-user.target
