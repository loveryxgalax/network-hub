{
	# No admin API at all (nothing to reach, published or not).
	admin off
	# Older CPEs (Cambium cnPilot R195W) may omit SNI. Always select this endpoint's managed certificate.
	default_sni {$ACS_TLS_HOST}
	email {$ACS_TLS_EMAIL}
}

{$ACS_TLS_HOST} {
	tls {
		protocols tls1.2 tls1.3
		key_type rsa2048
	}

	# Expose only CWMP, never the GenieACS NBI or the NetOps administration UI.
	# The path is passed through unchanged; headers (Authorization, Cookie) and the SOAP body are not touched.
	@cwmp path /cwmp /cwmp/*
	handle @cwmp {
		# acs:7548 is the existing connection-isolation proxy (a fresh GenieACS socket per request).
		reverse_proxy {$ACS_UPSTREAM:acs:7548} {
			transport http {
				keepalive off
			}
		}
	}
	handle {
		respond "Not found" 404
	}
}
