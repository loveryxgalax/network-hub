# Environment variables are read by Node; start with: node --env-file=.env server.cjs
HOST=127.0.0.1
PORT=4317
NETWORK_POLL_MS=30000
# NETWORK_DATA_DIR=C:/path/to/private/network-data
# NETWORK_CA_FILE=C:/path/to/router-certificate-authority.pem
# Cloudflare hostname. Keeps local HTTP usable, sets Secure cookies for this HTTPS host,
# and prevents first-run owner creation through the public hostname.
# NETWORK_PUBLIC_ORIGIN=https://network.your-domain.com
# Set only when serving through an HTTPS reverse proxy:
# NETWORK_SECURE_COOKIE=1
