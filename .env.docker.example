# Copy to .env on the server (never commit). Generate each password with: openssl rand -base64 32
MONGO_ROOT_USER=networkhub-admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=networkhub-acs
MONGO_APP_PASSWORD=
NETWORK_POLL_MS=30000
# Token of the Cloudflare tunnel created in Zero Trust → Networks → Tunnels (see docs/ALWAYS-ON.md).
TUNNEL_TOKEN=
# Memory caps (defaults fit Google's free e2-micro with the 2 GB swap from server-setup.sh). On a 4 GB server you can double them.
# HUB_MEMORY=300m
# MONGO_MEMORY=450m
# MONGO_CACHE_GB=0.25
# ACS_MEMORY=400m
# TUNNEL_MEMORY=100m
# MongoDB image. mongo:8.0 refuses Linux kernels 6.19+ (MongoDB SERVER-121912); set a version that starts on your server's kernel.
# MONGO_IMAGE=mongo:8.2   (8.2 starts on kernel 7.0; tested on Azure 2026-10-25)

# Netops RADIUS (replaces ISPman's). Generate each with: openssl rand -base64 24 | tr -d '/+='
# RADIUS_SECRET is shared with the MikroTiks; NETWORK_RADIUS_TOKEN stays between FreeRADIUS and the hub.
RADIUS_SECRET=
NETWORK_RADIUS_TOKEN=
