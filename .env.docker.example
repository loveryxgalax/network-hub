# Copy to .env on the server (never commit). Generate each password with: openssl rand -base64 32
MONGO_ROOT_USER=networkhub-admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=networkhub-acs
MONGO_APP_PASSWORD=
NETWORK_POLL_MS=30000
# Token of the Cloudflare tunnel created in Zero Trust → Networks → Tunnels (see docs/ALWAYS-ON.md).
TUNNEL_TOKEN=
# Memory caps (defaults fit Google's free e2-micro with the 2 GB swap from server-setup.sh). On a 4 GB server you can double them.
# HUB_MEMORY=300m
# MONGO_MEMORY=450m
# MONGO_CACHE_GB=0.25
# ACS_MEMORY=400m
# TUNNEL_MEMORY=100m
